flowchart TD
    S0["<b>SỐC ĐIỆN VỀ XOANG</b><br/>Ghi ĐK-9: phút từ sốc → bắt đầu map SR"]
    S1["<b>Dựng &amp; KHÓA 1 model hình học NT</b><br/>Advisor FL Circular, Sensor Enabled<br/>Dùng chung cho cả 2 lớp SR + Pace"]
    S2["<b>Cấu hình tín hiệu</b><br/>Lọc 30–300 Hz · Ngưỡng LVZ &lt;0,5 mV · Mật độ ≥3000 EGM/bản đồ"]
    S3["<b>Đo ERP tại chỗ</b><br/>Ngoại kích sensed, CS 1-2<br/>Coupling nhịp tạo = ERP + 30 ms"]
    S4["<b>Chọn 1 trong 7 vùng</b><br/>Trần · Trước · Sau · Vách · Bên · Antra 4 TMP · Sàn"]
    S5["Thu bản đồ HOẠT HÓA <b>NHỊP XOANG (SR)</b><br/>vùng này, đủ mật độ"]
    S6["Chuyển ngay ngoại kích CS<br/>Thu bản đồ HOẠT HÓA <b>NHỊP TẠO (Pace)</b><br/>ĐÚNG vùng vừa xong"]
    S7{"Đủ mật độ<br/>CẢ 2 lớp<br/>của vùng này?"}
    S8["Còn vùng chưa xong?"]
    S9["<b>Đọc isochrone 2 propagation</b><br/>2 người đọc độc lập<br/>bất đồng → người thứ 3 đọc mù"]

    D1{"Kiểu bất thường<br/>trên bản đồ hoạt hóa?"}
    D2["<b>PIVOT</b><br/>Mặt sóng bẻ hướng &gt;45°<br/>(isochrone quạt quanh 1 điểm)"]
    D3["<b>CORRIDOR chậm</b><br/>&gt;3 isochrone chụm<br/>trong bán kính 1 cm"]

    C1{"Xuất hiện ở<br/>mấy nhịp?"}
    C2["<b>FIXED (cố định)</b><br/>Cả SR và Pace<br/>→ sẹo thật"]
    C3["<b>FUNCTIONAL (chức năng)</b><br/>Chỉ SR HOẶC chỉ Pace"]
    C4{"Vùng này có<br/>&quot;LVZ&quot; chỉ ở<br/>1 nhịp?"}
    C5["⚠️ Gắn cờ <b>NGHI GIẢ DO HƯỚNG</b><br/>KHÔNG ghi sẹo cố định<br/>(REF-034 Butcher)"]
    C6["Ghi FUNCTIONAL thật"]

    E1["<b>Đo MÔ TẢ (thứ cấp)</b><br/>Điện thế · CV · Thời lượng EGM<br/>+ Hình thái LVZ (liền khối/manh mún)<br/>⚠️ 88% vị trí functional có ĐIỆN THẾ BÌNH THƯỜNG"]

    F1["Sau khi map xong toàn bộ 7 vùng"]
    F2["<b>PVI wide antral tiêu chuẩn</b><br/>Bất thường sát đường đốt → gộp vào vòng đốt"]
    F3["Đếm <b>vị trí FUNCTIONAL còn NGOÀI vòng PVI</b><br/>= &quot;residual&quot;<br/>(tiên lượng tái phát, KHÔNG cần map lại sau đốt)"]

    S0 --> S1 --> S2 --> S3 --> S4 --> S5 --> S6 --> S7
    S7 -- Chưa đủ --> S6
    S7 -- Đủ --> S8
    S8 -- Còn vùng --> S4
    S8 -- Hết 7 vùng --> S9
    S9 --> D1
    D1 -- có --> D2
    D1 -- có --> D3
    D2 --> C1
    D3 --> C1
    C1 -- Cả 2 nhịp --> C2
    C1 -- Chỉ 1 nhịp --> C3
    C3 --> C4
    C4 -- Có --> C5
    C4 -- Không --> C6
    C2 --> E1
    C6 --> E1
    C5 --> E1
    E1 --> F1 --> F2 --> F3

    classDef stepbox fill:#eef4ff,stroke:#2c5aa0,stroke-width:1px,color:#111;
    classDef corebox fill:#fff4e0,stroke:#b8730a,stroke-width:2px,color:#111;
    classDef decisionbox fill:#ffe6e6,stroke:#c0392b,stroke-width:1px,color:#111;
    classDef fixedbox fill:#e8f8e8,stroke:#2e7d32,stroke-width:2px,color:#111;
    classDef funcbox fill:#fff0f0,stroke:#c0392b,stroke-width:2px,color:#111;
    classDef flagbox fill:#ffd6d6,stroke:#a30000,stroke-width:2px,color:#111;
    classDef descbox fill:#f2f2f2,stroke:#555,stroke-width:1px,color:#111;
    classDef finalbox fill:#eaf7ff,stroke:#0b6aa2,stroke-width:2px,color:#111;

    class S0,S1,S2,S3,S4,S5,S6,S8,S9 stepbox;
    class D1,D2,D3 corebox;
    class S7,C1,C4 decisionbox;
    class C2 fixedbox;
    class C3,C6 funcbox;
    class C5 flagbox;
    class E1 descbox;
